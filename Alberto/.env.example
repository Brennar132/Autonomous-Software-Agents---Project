# Deliveroo.js server and the agent token it gave you
DELIVEROOJS_URL=http://localhost:8080
DELIVEROOJS_TOKEN=your-agent-token

# OpenAI-compatible endpoint (LiteLLM proxy, LM Studio, OpenAI...)
LITELLM_BASE_URL=https://your-llm-endpoint/v1
LITELLM_API_KEY=your-api-key
LOCAL_MODEL=llama-3.3-70b-lmstudio
